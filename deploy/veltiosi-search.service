[Unit]
Description=Veltiosi Search — Jev-routed search across all of Omni
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/satyamini/miniconda3/bin/python -m uvicorn server:app --host 127.0.0.1 --port 8611
WorkingDirectory=/home/satyamini/veltiosi
Environment="PATH=/home/satyamini/miniconda3/bin:/home/satyamini/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/satyamini/.hermes/.env
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target